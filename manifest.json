{
  "manifest_version": 3,
  "name": "T3 Approval Allowlist",
  "version": "0.3.0",
  "description": "仅对本地白名单中的完整命令自动批准 T3 Code 审批卡片。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://t3.like.cloud/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://t3.like.cloud/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "page-bridge.js"
      ],
      "matches": [
        "https://t3.like.cloud/*"
      ]
    }
  ]
}
